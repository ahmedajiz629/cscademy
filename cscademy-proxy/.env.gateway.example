# Copy this file to .env.gateway.local for local development or .env.gateway for a deployed gateway host.
# Replace every blank secret before starting the offline gateway.

# Private Convex endpoint used by the gateway runtime.
CONVEX_URL=http://127.0.0.1:3210

# Auth algorithm, issuer, and audience are fixed in code and must match the app.
# Generate both values below together and paste the two output lines:
# node --input-type=module -e "import { randomUUID } from 'node:crypto'; const { generateKeyPair, exportJWK, exportPKCS8 } = await import('jose'); const { publicKey, privateKey } = await generateKeyPair('RS256', { extractable: true }); const jwk = await exportJWK(publicKey); jwk.use = 'sig'; jwk.alg = 'RS256'; jwk.kid = randomUUID(); console.log('CONVEX_AUTH_PRIVATE_KEY=' + JSON.stringify((await exportPKCS8(privateKey)).replace(/\n/g, '\\n'))); console.log('CONVEX_AUTH_JWKS=' + JSON.stringify(JSON.stringify({ keys: [jwk] })));"
CONVEX_AUTH_PRIVATE_KEY=
CONVEX_AUTH_JWKS=

# Gateway token verification secret shared with the app.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OFFLINE_GATEWAY_SECRET=
OFFLINE_GATEWAY_HOST=0.0.0.0
OFFLINE_GATEWAY_PORT=8787