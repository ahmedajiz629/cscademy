# Copy this file to .env.local for local development or .env.server for server deployment.
# Replace every blank secret before starting the app.
# In production, point NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL at your same-origin
# Convex proxy, and keep CONVEX_INTERNAL_URL on the private backend address.

# Convex CLI and app endpoints
# Set CONVEX_DEPLOYMENT after running `pnpm exec convex dev` or linking a deployment.
CONVEX_DEPLOYMENT=anonymous:replace-with-your-convex-deployment
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
CONVEX_INTERNAL_URL=http://127.0.0.1:3210
CONVEX_URL=

# These must stay aligned with convex/auth.config.ts.
CONVEX_AUTH_ALGORITHM=RS256
CONVEX_AUTH_ISSUER=https://ajiz-tech-challenge.invalid/convex
CONVEX_AUTH_AUDIENCE=ajiz-tech-challenge

# Generate both values below together and paste the two output lines:
# node --input-type=module -e "import { randomUUID } from 'node:crypto'; const { generateKeyPair, exportJWK, exportPKCS8 } = await import('jose'); const { publicKey, privateKey } = await generateKeyPair('RS256', { extractable: true }); const jwk = await exportJWK(publicKey); jwk.use = 'sig'; jwk.alg = 'RS256'; jwk.kid = randomUUID(); console.log('CONVEX_AUTH_PRIVATE_KEY=' + JSON.stringify((await exportPKCS8(privateKey)).replace(/\n/g, '\\n'))); console.log('CONVEX_AUTH_JWKS=' + JSON.stringify(JSON.stringify({ keys: [jwk] })));"
CONVEX_AUTH_PRIVATE_KEY=
CONVEX_AUTH_JWKS=

# Platform authentication
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Offline gateway
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OFFLINE_GATEWAY_SECRET=
OFFLINE_GATEWAY_HOST=0.0.0.0
OFFLINE_GATEWAY_PORT=8787
OFFLINE_GATEWAY_URL=
NEXT_PUBLIC_OFFLINE_GATEWAY_PORT=8787
NEXT_PUBLIC_OFFLINE_GATEWAY_URL=
OFFLINE_ANTI_CHEAT_CANARY_IMAGE_URL=https://upload.wikimedia.org/wikipedia/commons/4/48/Person_running_Pinhead_icon.svg

# CTF encryption
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CTF_FLAG_ENCRYPTION_KEY=

# External CSAcademy integration for admin-linked evaluation accounts
CSACADEMY_EMAIL=
CSACADEMY_PASSWORD=

# Evaluator defaults
SOFTWARE_ENGINEERING_DOCKER_BIN=docker
LOGIC_REVERSE_ENGINEERING_DOCKER_BIN=docker

# Optional Docker daemon override for local Windows setups
# DOCKER_HOST=tcp://localhost:2375